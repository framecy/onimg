{
  "name": "onimg",
  "version": "1.0.0",
  "description": "Cloudflare Workers + R2 + D1 图片托管与静态原型托管服务",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secret": "wrangler secret put AUTH_KEY",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:css": "tailwindcss -i ./src/ui/aperture.css -o ./src/ui/aperture.generated.css --minify && node scripts/wrap-css.mjs",
    "pretest": "npm run build:css",
    "predev": "npm run build:css",
    "predeploy": "npm run build:css"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "marked": "^18.0.3"
  }
}
