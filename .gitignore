node_modules/
.wrangler/
.dev.vars
.DS_Store
# Tailwind v4 构建产物（由 build:css 生成，源文件为 src/ui/aperture.css）
src/ui/aperture.generated.css
src/ui/aperture.generated.js
# Agent CLI 构建产物（由 build:agent 从 scripts/onimg-agent.py 生成）
src/agent-cli.generated.js

# 部署配置：含个人账号的资源 ID（account_id / KV namespace / D1 database），
# 不随公开仓库分发。仓库里放的是 wrangler.toml.example，复制一份填自己的值：
#     cp wrangler.toml.example wrangler.toml
wrangler.toml
# 但示例文件本身要提交
!wrangler.toml.example

# 一次性验证/调试脚本（下划线前缀约定：本机探针、临时核验，不随仓库分发）
scripts/_*.mjs
scripts/_*.sh

# 本地 IDE / 工具配置
.claude/

# 本地工作日志/记忆（可能含个人信息），不随公开仓库分发
.workbuddy/
# Python 编译缓存（误入仓库过：scripts/__pycache__/*.pyc 已从历史清除）
__pycache__/
*.pyc
